# Raw STF dataset (~160 GB) — download with download_stf_subset.py
/data/

# Generated/converted data (~67 GB) — regenerate with baseline/scripts
baseline/data/_merged_zips/
baseline/data/kitti_source/
baseline/data/kitti_format/training/
baseline/data/kitti_format/*.pkl
baseline/data/kitti_format/gt_database/

# Training checkpoints and eval output — regenerate with the GPU-box run order
# in baseline/README.md (too large and too easy to regenerate to version)
baseline/output/
models/*/output/

# Local debug/build logs from running the pipeline scripts
convert_log*.txt
create_infos_log*.txt
docker_build_log*.txt
download_log_rerun.txt
eval_only_log*.txt
extract_log.txt
image_extract_log.txt
train_1epoch_log*.txt

# Personal drafts
scratch_ta_email_draft.txt
DEMO_SCRIPT.sh
start_full_training.sh
train_full80_log.txt

# Python / OS
__pycache__/
*.pyc
.DS_Store
.venv/
venv/

# corruption/third_party/LiDAR_fog_sim/ is vendored from source (no pip package exists for it) and kept in git,
# LUT pickles included (~1.7 MB; not regenerable from anything else in this repo without the vendored code
# itself, see corruption/DESIGN.md section 7). Pruned on vendoring to only what simulate_fog/ParameterSet actually
# need: removed file_lists/ (manifests for 9 other datasets' viewer tooling we never use, ~57 MB, mostly one
# 26 MB nuScenes.pkl + 23 MB nuScenes.txt), .github/ (upstream's own CI), theory.py and pointcloud_viewer.py (a
# PyQt5 GUI we don't run and don't want to pull as a dependency), and the SeeingThroughFog submodule + its nested
# .git (failed to clone over SSH; unused -- our STF data comes through this repo's own baseline pipeline). If a
# future re-vendor restores any of these, ignore them here rather than re-adding the bloat or a git-repo-in-repo.
corruption/third_party/LiDAR_fog_sim/.git/
corruption/third_party/LiDAR_fog_sim/SeeingThroughFog/
corruption/third_party/LiDAR_fog_sim/file_lists/
corruption/third_party/LiDAR_fog_sim/.github/
corruption/third_party/LiDAR_fog_sim/theory.py
corruption/third_party/LiDAR_fog_sim/pointcloud_viewer.py
